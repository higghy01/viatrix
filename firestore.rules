rules_version = '2';
// Viatrix: ogni telefono scrive solo il suo riepilogo anonimo (nome casuale lungo).
// Niente nomi, città, date, foto o note. Legge solo il proprietario (il suo ID utente qui sotto).
// Ogni campo è controllato: solo codici di paesi veri, mezzi conosciuti e numeri interi (niente testo libero).
service cloud.firestore {
  match /databases/{db}/documents {
    match /dispositivi/{id} {
      function elenco() { return ['AD', 'AE', 'AF', 'AG', 'AI', 'AL', 'AM', 'AO', 'AQ', 'AR', 'AS', 'AT', 'AU', 'AW', 'AX', 'AZ', 'BA', 'BB', 'BD', 'BE', 'BF', 'BG', 'BH', 'BI', 'BJ', 'BL', 'BM', 'BN', 'BO', 'BQ', 'BR', 'BS', 'BT', 'BV', 'BW', 'BY', 'BZ', 'CA', 'CC', 'CD', 'CF', 'CG', 'CH', 'CI', 'CK', 'CL', 'CM', 'CN', 'CO', 'CR', 'CU', 'CV', 'CW', 'CX', 'CY', 'CZ', 'DE', 'DJ', 'DK', 'DM', 'DO', 'DZ', 'EC', 'EE', 'EG', 'EH', 'ER', 'ES', 'ET', 'FI', 'FJ', 'FK', 'FM', 'FO', 'FR', 'GA', 'GB', 'GD', 'GE', 'GF', 'GG', 'GH', 'GI', 'GL', 'GM', 'GN', 'GP', 'GQ', 'GR', 'GS', 'GT', 'GU', 'GW', 'GY', 'HK', 'HM', 'HN', 'HR', 'HT', 'HU', 'ID', 'IE', 'IL', 'IM', 'IN', 'IO', 'IQ', 'IR', 'IS', 'IT', 'JE', 'JM', 'JO', 'JP', 'KE', 'KG', 'KH', 'KI', 'KM', 'KN', 'KP', 'KR', 'KW', 'KY', 'KZ', 'LA', 'LB', 'LC', 'LI', 'LK', 'LR', 'LS', 'LT', 'LU', 'LV', 'LY', 'MA', 'MC', 'MD', 'ME', 'MF', 'MG', 'MH', 'MK', 'ML', 'MM', 'MN', 'MO', 'MP', 'MQ', 'MR', 'MS', 'MT', 'MU', 'MV', 'MW', 'MX', 'MY', 'MZ', 'NA', 'NC', 'NE', 'NF', 'NG', 'NI', 'NL', 'NO', 'NP', 'NR', 'NU', 'NZ', 'OM', 'PA', 'PE', 'PF', 'PG', 'PH', 'PK', 'PL', 'PM', 'PN', 'PR', 'PS', 'PT', 'PW', 'PY', 'QA', 'RE', 'RO', 'RS', 'RU', 'RW', 'SA', 'SB', 'SC', 'SD', 'SE', 'SG', 'SH', 'SI', 'SJ', 'SK', 'SL', 'SM', 'SN', 'SO', 'SR', 'SS', 'ST', 'SV', 'SX', 'SY', 'SZ', 'TC', 'TD', 'TF', 'TG', 'TH', 'TJ', 'TK', 'TL', 'TM', 'TN', 'TO', 'TR', 'TT', 'TV', 'TW', 'TZ', 'UA', 'UG', 'UM', 'US', 'UY', 'UZ', 'VA', 'VC', 'VE', 'VG', 'VI', 'VN', 'VU', 'WF', 'WS', 'XK', 'YE', 'YT', 'ZA', 'ZM', 'ZW']; }
      function codici(l) { return l is list && l.size() <= 260 && l.hasOnly(elenco()); }
      function quanti(m, k) { return !(k in m) || (m[k] is int && m[k] >= 0 && m[k] < 100000); }
      function mezzi(m) { return m is map && m.keys().hasOnly(['aereo', 'treno', 'auto', 'nave', 'bus', 'camper', 'moto', 'bici', 'piedi']) && quanti(m, 'aereo') && quanti(m, 'treno') && quanti(m, 'auto') && quanti(m, 'nave') && quanti(m, 'bus') && quanti(m, 'camper') && quanti(m, 'moto') && quanti(m, 'bici') && quanti(m, 'piedi'); }
      function giorno(s) { return s is string && s.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'); }
      function valido() {
        let d = request.resource.data;
        return id.matches('^[a-z0-9]{20,40}$')
          && d.keys().hasOnly(['v', 'casa', 'os', 'primo', 'ultimo', 'aperture', 'paesi', 'vivo', 'sogni', 'citta', 'foto', 'giorni', 'livello', 'trofei', 'mezzi'])
          && d.v is string && d.v.matches('^[0-9.]{1,10}$')
          && d.casa is bool
          && d.os in ['ios', 'android', 'altro']
          && giorno(d.primo) && giorno(d.ultimo)
          && d.aperture is int && d.aperture >= 0 && d.aperture < 1000000
          && codici(d.paesi) && codici(d.vivo) && codici(d.sogni)
          && d.citta is int && d.citta >= 0 && d.citta < 100000
          && d.foto is int && d.foto >= 0 && d.foto < 1000000
          && d.giorni is int && d.giorni >= 0 && d.giorni < 100000
          && d.livello is int && d.livello >= 0 && d.livello < 10
          && d.trofei is int && d.trofei >= 0 && d.trofei < 100
          && mezzi(d.mezzi);
      }
      allow create, update: if valido();
      allow read: if request.auth != null && request.auth.uid == 'XWWfnbGa1YOWGtkcrtVcrc51teC3';
      allow delete: if false;
    }
  }
}
